{
  "name": "toonflow",
  "version": "2.0.0",
  "description": "Bun-powered AI workstation for turning stories and scripts into short-form animated productions.",
  "homepage": "https://github.com/reedchan7/Toonflow-app#readme",
  "bugs": {
    "url": "https://github.com/reedchan7/Toonflow-app/issues"
  },
  "license": "Apache-2.0",
  "author": "reedchan7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reedchan7/Toonflow-app.git"
  },
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "dev": "bun --watch --inspect src/app.ts",
    "dev:gui": "bun scripts/dev-gui.ts",
    "dev:gui-vite": "cross-env VITE_DEV=1 bun scripts/dev-gui.ts",
    "start": "cross-env NODE_ENV=prod bun data/serve/app.js",
    "format": "oxfmt --write src scripts README.md package.json tsconfig.json electron-builder.yml .github .oxfmtrc.json .oxlintrc.json lefthook.yml",
    "format:check": "oxfmt --check src scripts README.md package.json tsconfig.json electron-builder.yml .github .oxfmtrc.json .oxlintrc.json lefthook.yml",
    "lint": "oxlint --deny-warnings src scripts",
    "lint:fix": "oxlint --fix src scripts",
    "runtime:check": "bun scripts/check-runtime.ts",
    "modules:check": "bun scripts/check-modules.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "check": "bun run runtime:check && bun run modules:check && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "ci": "bun run check && bun run build",
    "build": "cross-env NODE_ENV=prod bun scripts/build.ts",
    "pack": "bun run build && bun --bun electron-builder --dir",
    "dist": "bun run build && bun --bun electron-builder",
    "dist:win": "bun run build && bun --bun electron-builder --win",
    "dist:mac": "bun run build && bun --bun electron-builder --mac",
    "dist:linux": "bun run build && bun --bun electron-builder --linux",
    "debug:ai": "bunx --bun @ai-sdk/devtools",
    "license": "bun scripts/license.ts",
    "vendor2json": "bun scripts/vendor2json.ts",
    "hooks": "lefthook install",
    "prepare": "bun scripts/prepare.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/deepseek": "^3.0.31",
    "@ai-sdk/devtools": "^1.0.12",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@ai-sdk/xai": "^4.0.43",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.77",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "compressing": "^2.1.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.6",
    "graphlib": "^2.1.8",
    "is-path-inside": "^4.0.0",
    "js-md5": "^0.9.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "morgan": "^1.11.0",
    "p-limit": "^7.3.1",
    "qwen-ai-provider-v5": "^2.1.3",
    "serialize-error": "^13.0.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.2",
    "vercel-minimax-ai-provider": "^0.0.2",
    "zhipu-ai-provider": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rmp135/sql-ts": "^2.2.0",
    "@types/bun": "1.4.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/graphlib": "^2.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/license-checker": "^25.0.6",
    "@types/lodash": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "lefthook": "2.1.10",
    "license-checker": "^25.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.1",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild",
    "lefthook",
    "lzma-native",
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "sqlite3"
  ]
}
