{
  "name": "toonflow",
  "version": "2.0.0",
  "private": true,
  "description": "Bun-powered AI workstation for turning stories and scripts into short-form animated productions.",
  "homepage": "https://github.com/reedchan7/Toonflow-app#readme",
  "bugs": {
    "url": "https://github.com/reedchan7/Toonflow-app/issues"
  },
  "license": "Apache-2.0",
  "author": "reedchan7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reedchan7/Toonflow-app.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "dev": "bun --watch --inspect apps/server/src/app.ts",
    "dev:server": "bun --watch --inspect apps/server/src/app.ts",
    "dev:desktop": "bun apps/desktop/src/dev.ts",
    "dev:gui": "bun run dev:desktop",
    "dev:gui-vite": "cross-env VITE_DEV=1 bun run dev:desktop",
    "start": "cross-env NODE_ENV=prod bun data/serve/app.js",
    "format": "oxfmt --write apps/server apps/web apps/desktop packages/contracts scripts README.md package.json tsconfig.json tsconfig.base.json electron-builder.yml .github .oxfmtrc.json .oxlintrc.json lefthook.yml",
    "format:check": "oxfmt --check apps/server apps/web apps/desktop packages/contracts scripts README.md package.json tsconfig.json tsconfig.base.json electron-builder.yml .github .oxfmtrc.json .oxlintrc.json lefthook.yml",
    "lint": "oxlint --deny-warnings apps/server apps/web apps/desktop scripts",
    "lint:fix": "oxlint --fix apps/server apps/web apps/desktop scripts",
    "runtime:check": "bun scripts/check-runtime.ts",
    "modules:check": "bun scripts/check-modules.ts",
    "architecture:check": "bun scripts/check-architecture.ts",
    "routes:generate": "bun apps/server/src/core.ts",
    "routes:check": "bun apps/server/src/core.ts --check",
    "openapi:generate": "bun scripts/generate-openapi.ts",
    "openapi:check": "bun scripts/generate-openapi.ts --check",
    "provenance:check": "bun scripts/check-web-provenance.ts",
    "provenance:source:check": "bun scripts/check-web-provenance.ts",
    "release:evidence": "bun scripts/check-release-evidence.ts",
    "secrets:check": "cross-env TOONFLOW_SECRET_SCAN_CANARY=toonflow-release-canary-not-for-packaging bun scripts/check-secrets.ts",
    "benchmark:provider-kernel": "bun scripts/benchmark-provider-kernel.ts",
    "benchmark:http": "bun scripts/benchmark-http.ts",
    "release:check": "bun run provenance:source:check && bun run benchmark:provider-kernel && bun run release:evidence && bun run secrets:check",
    "workspace:check": "bun scripts/check-workspaces.ts",
    "contracts:generate": "bun scripts/generate-contracts.ts",
    "contracts:check": "bun scripts/generate-contracts.ts --check",
    "web:dev": "bun run --cwd apps/web dev",
    "web:typecheck": "bun run --cwd apps/web typecheck",
    "web:test": "bun run --cwd apps/web test",
    "web:build": "bun run --cwd apps/web build-only",
    "web:check": "bun run --cwd apps/web check",
    "web:package": "bun scripts/package-web.ts",
    "server:typecheck": "tsc --noEmit -p apps/server/tsconfig.json",
    "server:test": "bun scripts/test-server.ts",
    "server:forbidden": "bun scripts/check-forbidden-frameworks.ts --server",
    "server:check": "bun run server:typecheck && bun run server:forbidden && bun run server:test",
    "desktop:typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "desktop:probe": "bun scripts/probe-electron-vault.ts",
    "desktop:check": "bun run desktop:typecheck && bun run desktop:probe",
    "build:runtime": "cross-env NODE_ENV=prod bun scripts/build.ts",
    "runtime:probe": "bun scripts/probe-server-runtime.ts",
    "acceptance:fixture": "bun scripts/deterministic-product-fixture.ts",
    "acceptance:deterministic": "bun scripts/acceptance-deterministic.ts",
    "live:test": "bun scripts/run-live-tests.ts",
    "live:review": "bun scripts/review-live-report.ts",
    "typecheck": "tsc --noEmit",
    "test:server": "bun scripts/test-server.ts",
    "test": "bun run test:server && bun run web:test",
    "test:watch": "bun scripts/test-server.ts --watch",
    "check": "bun run runtime:check && bun run workspace:check && bun run modules:check && bun run architecture:check && bun run routes:check && bun run openapi:check && bun run contracts:check && bun run format:check && bun run lint && bun run typecheck && bun run web:check && bun run test:server",
    "ci": "bun run check && bun run build",
    "build": "bun run provenance:check && cross-env NODE_ENV=prod bun scripts/build.ts",
    "pack": "bun run release:check && bun run build && bun --bun electron-builder --dir && bun run secrets:check",
    "dist": "bun run release:check && bun run build && bun --bun electron-builder && bun run secrets:check",
    "dist:win": "bun run release:check && bun run build && bun --bun electron-builder --win && bun run secrets:check",
    "dist:mac": "bun run release:check && bun run build && bun --bun electron-builder --mac && bun run secrets:check",
    "dist:linux": "bun run release:check && bun run build && bun --bun electron-builder --linux && bun run secrets:check",
    "debug:ai": "bunx --bun @ai-sdk/devtools",
    "license": "bun scripts/license.ts",
    "vendor2json": "bun scripts/vendor2json.ts",
    "hooks": "lefthook install",
    "prepare": "bun scripts/prepare.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/deepseek": "^3.0.31",
    "@ai-sdk/devtools": "^1.0.12",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/provider-utils": "5.0.29",
    "@ai-sdk/xai": "^4.0.43",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "2.18.0",
    "@hono/node-server": "2.1.1",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.77",
    "ajv": "^8.20.0",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "compressing": "^2.1.3",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.6",
    "graphlib": "^2.1.8",
    "hono": "4.13.3",
    "ipaddr.js": "^2.5.0",
    "is-path-inside": "^4.0.0",
    "js-md5": "^0.9.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "lodash": "^4.18.1",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "p-limit": "^7.3.1",
    "qwen-ai-provider-v5": "^2.1.3",
    "serialize-error": "^13.0.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "4.8.3",
    "sqlite3": "^6.0.1",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.2",
    "vercel-minimax-ai-provider": "^0.0.2",
    "zhipu-ai-provider": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rmp135/sql-ts": "^2.2.0",
    "@types/bun": "1.4.0",
    "@types/graphlib": "^2.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/license-checker": "^25.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "26.2.0",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "lefthook": "2.1.10",
    "license-checker": "^25.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.1",
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild",
    "lefthook",
    "lzma-native",
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "sqlite3"
  ]
}
