{
  "extends": "../../tsconfig.base.json",
  "include": ["vite.config.ts", "vitest.config.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
