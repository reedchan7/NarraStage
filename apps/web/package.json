{
  "name": "@toonflow/web",
  "version": "2.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "preview": "vite preview --host localhost",
    "build": "bun run typecheck && vite build",
    "build-only": "vite build",
    "build:meta": "node scripts/writeBuildMeta.ts",
    "api:generate": "bun run --cwd ../.. contracts:generate",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test && bun run build-only",
    "license": "bun scripts/license.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.2",
    "@toonflow/contracts": "workspace:*",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "socket.io-client": "4.8.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "4.1.11"
  }
}
