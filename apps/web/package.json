{
  "name": "@toonflow/web",
  "version": "2.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview",
    "build": "bun run typecheck && vite build",
    "build-only": "vite build",
    "build:meta": "node scripts/writeBuildMeta.ts",
    "api:generate": "bun run --cwd ../.. contracts:generate",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test && bun run i18n:check && bun run build-only",
    "license": "bun scripts/license.ts",
    "i18n:check": "bun scripts/findUnusedI18n.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@devui-design/icons": "^1.4.0",
    "@icon-park/vue-next": "^1.4.2",
    "@tdesign-vue-next/chat": "^0.5.1",
    "@toonflow/contracts": "workspace:*",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.1.0",
    "@webav/av-canvas": "^1.2.8",
    "@webav/av-cliper": "^1.2.8",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "js-confetti": "^0.13.1",
    "jszip": "^3.10.1",
    "lodash": "^4.17.23",
    "mammoth": "^1.12.0",
    "md-editor-v3": "^6.4.0",
    "monaco-editor": "^0.55.1",
    "monaco-editor-vue3": "^1.0.5",
    "p-limit": "^7.3.0",
    "pinia": "^2.2.6",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass": "^1.97.0",
    "socket.io-client": "^4.8.3",
    "splitpanes": "^4.0.4",
    "tdesign-vue-next": "^1.18.5",
    "uuid": "^13.0.0",
    "vue": "^3.5.12",
    "vue-clip-track": "^0.1.5",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "11",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tdesign-vue-next/auto-import-resolver": "^0.1.6",
    "@tsconfig/node22": "^22.0.0",
    "@types/license-checker": "^25.0.6",
    "@types/node": "26.2.0",
    "@types/splitpanes": "^2.2.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "happy-dom": "^15.11.7",
    "license-checker": "^25.0.1",
    "postcss-px-to-viewport": "^1.1.1",
    "prettier": "^3.3.3",
    "typescript": "7.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^2.1.9",
    "vue-tsc": "3.3.11"
